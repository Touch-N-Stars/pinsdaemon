#!/bin/sh
set -e

# Create user if it doesn't exist
if ! id "sysupdate-api" >/dev/null 2>&1; then
    useradd -r -s /bin/false sysupdate-api
fi

# Set permissions
chown -R sysupdate-api:sysupdate-api /opt/pinsdaemon
mkdir -p /opt/pinsdaemon/logs
chown sysupdate-api:sysupdate-api /opt/pinsdaemon/logs
chmod 750 /opt/pinsdaemon/logs

# Ensure sudoers file is owned by root (Critical for sudo to work)
chown root:root /etc/sudoers.d/sysupdate-api
chmod 440 /etc/sudoers.d/sysupdate-api

# Ensure upgrade script is owned by root (Security)
if [ -f "/usr/local/bin/system-upgrade.sh" ]; then
    chown root:root /usr/local/bin/system-upgrade.sh
    chmod 755 /usr/local/bin/system-upgrade.sh
fi

if [ -f "/usr/local/bin/install-firmware.sh" ]; then
    chown root:root /usr/local/bin/install-firmware.sh
    chmod 755 /usr/local/bin/install-firmware.sh
fi

if [ -f "/usr/local/bin/install-indi-package.sh" ]; then
    chown root:root /usr/local/bin/install-indi-package.sh
    chmod 755 /usr/local/bin/install-indi-package.sh
fi

if [ -f "/usr/local/bin/install-astap-star-database.sh" ]; then
    chown root:root /usr/local/bin/install-astap-star-database.sh
    chmod 755 /usr/local/bin/install-astap-star-database.sh
fi

if [ -f "/usr/local/bin/ensure-required-packages.sh" ]; then
    chown root:root /usr/local/bin/ensure-required-packages.sh
    chmod 755 /usr/local/bin/ensure-required-packages.sh
fi

if [ -f "/usr/local/bin/manage-plugin.sh" ]; then
    chown root:root /usr/local/bin/manage-plugin.sh
    chmod 755 /usr/local/bin/manage-plugin.sh
fi

if [ -f "/usr/local/bin/wifi-connect.sh" ]; then
    chmod 755 /usr/local/bin/wifi-connect.sh
fi

if [ -f "/usr/local/bin/wifi-automanage.py" ]; then
    chmod 755 /usr/local/bin/wifi-automanage.py
fi

if [ -f "/usr/local/bin/manage-samba.sh" ]; then
    chown root:root /usr/local/bin/manage-samba.sh
    chmod 755 /usr/local/bin/manage-samba.sh
fi

if [ -f "/usr/local/bin/wifi-connect.sh" ]; then
    chown root:root /usr/local/bin/wifi-connect.sh
    chmod 755 /usr/local/bin/wifi-connect.sh
fi

if [ -f "/usr/local/bin/pins-rig-name" ]; then
    chown root:root /usr/local/bin/pins-rig-name
    chmod 755 /usr/local/bin/pins-rig-name
fi

if [ -f "/usr/local/bin/wifi-automanage.py" ]; then
    chown root:root /usr/local/bin/wifi-automanage.py
    chmod 755 /usr/local/bin/wifi-automanage.py
fi

if [ -f "/usr/local/bin/collect-diagnostics.sh" ]; then
    chown root:root /usr/local/bin/collect-diagnostics.sh
    chmod 755 /usr/local/bin/collect-diagnostics.sh
fi

if [ -f "/usr/local/bin/pins-wifi-watchdog.sh" ]; then
    chown root:root /usr/local/bin/pins-wifi-watchdog.sh
    chmod 755 /usr/local/bin/pins-wifi-watchdog.sh
fi

if [ -f "/home/pi/pins-scripts/hotspot.sh" ]; then
    chown pi:pi /home/pi/pins-scripts/hotspot.sh
    chmod 755 /home/pi/pins-scripts/hotspot.sh
fi

if id "pi" >/dev/null 2>&1; then
    BASHRC_FILE="/home/pi/.bashrc"
    if [ -f "$BASHRC_FILE" ]; then
        sed -i '/^>>> PINS WELCOME >>>/,/^<<< PINS WELCOME <<</d' "$BASHRC_FILE"
        sed -i '/# >>> PINS WELCOME >>>/,/# <<< PINS WELCOME <<</d' "$BASHRC_FILE"
        cat >> "$BASHRC_FILE" <<'EOF'

# >>> PINS WELCOME >>>
    if [[ $- == *i* && -n "$SSH_CONNECTION" ]]; then
echo "                                                                                        "
echo "PPPPPPPPPPPPPPPPP        IIIIIIIIII     NNNNNNNN        NNNNNNNN        SSSSSSSSSSSSSSS "
echo "P::::::::::::::::P       I::::::::I     N:::::::N       N::::::N      SS:::::::::::::::S"
echo "P::::::PPPPPP:::::P      I::::::::I     N::::::::N      N::::::N     S:::::SSSSSS::::::S"
echo "PP:::::P     P:::::P     II::::::II     N:::::::::N     N::::::N     S:::::S     SSSSSSS"
echo "  P::::P     P:::::P       I::::I       N::::::::::N    N::::::N     S:::::S            "
echo "  P::::P     P:::::P       I::::I       N:::::::::::N   N::::::N     S:::::S            "
echo "  P::::PPPPPP:::::P        I::::I       N:::::::N::::N  N::::::N      S::::SSSS         "
echo "  P:::::::::::::PP         I::::I       N::::::N N::::N N::::::N       SS::::::SSSSS    "
echo "  P::::PPPPPPPPP           I::::I       N::::::N  N::::N:::::::N         SSS::::::::SS  "
echo "  P::::P                   I::::I       N::::::N   N:::::::::::N            SSSSSS::::S "
echo "  P::::P                   I::::I       N::::::N    N::::::::::N                 S:::::S"
echo "  P::::P                   I::::I       N::::::N     N:::::::::N                 S:::::S"
echo "PP::::::PP               II::::::II     N::::::N      N::::::::N     SSSSSSS     S:::::S"
echo "P::::::::P               I::::::::I     N::::::N       N:::::::N     S::::::SSSSSS:::::S"
echo "P::::::::P               I::::::::I     N::::::N        N::::::N     S:::::::::::::::SS "
echo "PPPPPPPPPP               IIIIIIIIII     NNNNNNNN         NNNNNNN      SSSSSSSSSSSSSSS   "
echo "                                                                                        "
echo "                                                                                        "
echo "version 1.3 Copyright PINS / Touch-N-Stars 2026"
fi
# <<< PINS WELCOME <<<
EOF
        chown pi:pi "$BASHRC_FILE"
    fi
fi

if [ -f "/usr/local/bin/wifi-scan.py" ]; then
    chown root:root /usr/local/bin/wifi-scan.py
    chmod 755 /usr/local/bin/wifi-scan.py
fi

if [ -f "/etc/NetworkManager/dispatcher.d/90-pins-wifi-recovery" ]; then
    chown root:root /etc/NetworkManager/dispatcher.d/90-pins-wifi-recovery
    chmod 755 /etc/NetworkManager/dispatcher.d/90-pins-wifi-recovery
fi

# Keep the PINS fallback hotspot local-only. NetworkManager shared mode still
# serves DHCP, but dnsmasq suppresses router/DNS options so phones keep LTE/5G
# as their Internet route while connected to the device AP.
mkdir -p /etc/NetworkManager/dnsmasq-shared.d
cat > /etc/NetworkManager/dnsmasq-shared.d/pins-local-only.conf <<'EOF'
# PINS fallback hotspot is local-only: hand out an address, but no gateway/DNS.
# This keeps phones using LTE/5G for Internet while connected to the device AP.
dhcp-option=3
dhcp-option=6
EOF
chown root:root /etc/NetworkManager/dnsmasq-shared.d/pins-local-only.conf
chmod 644 /etc/NetworkManager/dnsmasq-shared.d/pins-local-only.conf

# Ensure service file is owned by root
chown root:root /etc/systemd/system/sysupdate-api.service
chmod 644 /etc/systemd/system/sysupdate-api.service

# Ensure Wi-Fi watchdog timer/service files are owned by root
if [ -f "/etc/systemd/system/pins-wifi-watchdog.service" ]; then
    chown root:root /etc/systemd/system/pins-wifi-watchdog.service
    chmod 644 /etc/systemd/system/pins-wifi-watchdog.service
fi
if [ -f "/etc/systemd/system/pins-wifi-watchdog.timer" ]; then
    chown root:root /etc/systemd/system/pins-wifi-watchdog.timer
    chmod 644 /etc/systemd/system/pins-wifi-watchdog.timer
fi

# Preserve system and recovery logs across reboot. The package owns only the
# drop-in; existing administrator settings in journald.conf remain untouched.
if [ -f "/etc/systemd/journald.conf.d/90-pins-persistent.conf" ]; then
    chown root:root /etc/systemd/journald.conf.d/90-pins-persistent.conf
    chmod 644 /etc/systemd/journald.conf.d/90-pins-persistent.conf
    mkdir -p /var/log/journal
    if getent group systemd-journal >/dev/null 2>&1; then
        chown root:systemd-journal /var/log/journal
    else
        chown root:root /var/log/journal
    fi
    chmod 2755 /var/log/journal
    systemctl restart systemd-journald || true
    journalctl --flush || true
fi

# Use the same stable, hardware-derived name for the OS/mDNS hostname and the
# fallback hotspot SSID. Avahi conflict suffixes such as pins-2.local are then
# avoided when several PINS rigs share a LAN.
if [ -x "/usr/local/bin/pins-rig-name" ]; then
    PINS_RIG_NAME=$(/usr/local/bin/pins-rig-name --ensure)
    CURRENT_HOSTNAME=$(hostname 2>/dev/null || true)
    if [ "$CURRENT_HOSTNAME" != "$PINS_RIG_NAME" ]; then
        hostnamectl set-hostname "$PINS_RIG_NAME"
        if [ -f /etc/hosts ]; then
            if grep -q '^127\.0\.1\.1[[:space:]]' /etc/hosts; then
                sed -i "s/^127\\.0\\.1\\.1.*/127.0.1.1 ${PINS_RIG_NAME}/" /etc/hosts
            else
                printf '127.0.1.1 %s\n' "$PINS_RIG_NAME" >> /etc/hosts
            fi
        fi
    fi
fi

if [ -f "/etc/avahi/services/pinsdaemon.service" ]; then
    chown root:root /etc/avahi/services/pinsdaemon.service
    chmod 644 /etc/avahi/services/pinsdaemon.service
    systemctl enable --now avahi-daemon || true
    systemctl restart avahi-daemon || true
fi

# Ensure ASI udev rules file has correct ownership and mode
if [ -f "/lib/udev/rules.d/99-asi.rules" ]; then
    chown root:root /lib/udev/rules.d/99-asi.rules
    chmod 644 /lib/udev/rules.d/99-asi.rules
fi

# Setup Python virtual environment
cd /opt/pinsdaemon
if [ ! -d "venv" ]; then
    echo "Creating virtual environment..."
    python3 -m venv venv
fi

# Install dependencies
if [ -f "requirements.txt" ]; then
    echo "Installing Python dependencies..."
    ./venv/bin/pip install -r requirements.txt
fi

# Fix ownership of venv created by root
chown -R sysupdate-api:sysupdate-api /opt/pinsdaemon/venv

# Systemd setup
systemctl daemon-reload
systemctl enable sysupdate-api
systemctl restart sysupdate-api

# Active Wi-Fi connectivity watchdog: catches the case where NetworkManager
# never fires a dispatcher event (e.g. the client interface still reports
# "connected" while the router/AP behind it is actually dead), which
# otherwise leaves 90-pins-wifi-recovery never invoked.
if [ -f "/etc/systemd/system/pins-wifi-watchdog.timer" ]; then
    systemctl enable --now pins-wifi-watchdog.timer
fi

# Prevent gvfs camera monitor from being auto-started by user sessions.
# Apply a global user-unit mask and best-effort stop/mask for pi's current session.
systemctl --global mask gvfs-gphoto2-volume-monitor.service || true
if id "pi" >/dev/null 2>&1; then
    PI_UID=$(id -u pi)
    su - pi -c "XDG_RUNTIME_DIR=/run/user/${PI_UID} systemctl --user stop gvfs-gphoto2-volume-monitor.service" || true
    su - pi -c "XDG_RUNTIME_DIR=/run/user/${PI_UID} systemctl --user mask gvfs-gphoto2-volume-monitor.service" || true
fi

# After update/install, bring PINS service back up.
if systemctl list-unit-files pins.service >/dev/null 2>&1; then
    systemctl start pins.service || true
else
    systemctl start pins || true
fi

# Reload udev rules after install/upgrade so updated rule file is active
if command -v udevadm >/dev/null 2>&1; then
    udevadm control --reload-rules || true
    udevadm trigger --subsystem-match=usb || true
fi

exit 0
